  "partition": {
    "digest_core": "e9300a9ec3a61de9",
    "id_agreed": "b8629ccbff0ccb8d",
    "id_source": "the agreed binary partition identity: IEEE-754 big-endian doubles at fixed widths, an explicit field order, and no text rendering anywhere. Computed here by partition_id_bytes() and in the browser by client/web/src/partition_id.js, from the same specification. This is the one that is stable under how world.json spells a number, which digest_core is not.",
    "digest_source": "computed by this script calling shared.terrain.field_layout.digest_partition on a FieldAlbedo rebuilt from world.json:fields_status. The browser recomputes it with client/web/src/digest.js and stamps both, so a difference between the two implementations is visible on the picture rather than in a test nobody reads. This is the one place a second client observes the core.",
    "cells": 0,
    "edges": 0
  },
