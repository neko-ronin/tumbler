{
  "area_m2": {
    "block": 16777216.0,
    "stamped": 8968512.0,
    "stamped_fraction_of_block": 0.534565
  },
  "authority": "AGENTS.md, 'The core owns the map, not the blades', ruled by the human on 2026-10-04. Ground cover is recorded as a plant type and a density and is interpreted per client. A planting is core-owned as an individual only when it stands at a place that has a name, and that is derived from its position rather than declared on it; see the `planting` block.",
  "density": {
    "client_may": "grow denser grass, draw blades a player can walk through, wind a wave across the meadow, batch into patches or scatter per cell, or not draw ground cover at all. None of that is the core's to say.",
    "cover_fraction": 0.785398,
    "flower_clusters_per_m2": 0.14132958946560306,
    "flower_colour_mix": {
      "orange": 0.15,
      "red": 0.05,
      "violet": 0.43,
      "white": 0.37
    },
    "flower_cover_fraction": 0.111,
    "reference_kit": {
      "flower_clump_diameter_m": 1.0,
      "path": "shared/geometry/meadow/",
      "status": "a reference, not authority. Appearance is the client's under the 2026-10-04 ruling, so the two *_per_m2 figures are ONE interpretation derived from this kit's measured crown and a client may replace both the kit and the numbers. cover_fraction does not depend on it.",
      "tuft_crown_diameter_m": 1.0
    },
    "rule": {
      "closure": "A closed meadow has no bare ground between the crowns of its plants, so the lattice pitch is the crown diameter. Crowns of diameter d on a square lattice cover pi (d/2)^2 / d^2 = pi/4 of the ground, whatever d is, so cover_fraction is a property of the rule and not of any asset.",
      "coverage": "Flowers are not a closure. The references' ground is a median 11.1% saturated non-green, measured by shared/geometry/meadow_census.py and recorded in MEADOW-ASSESSMENT.md section 1, and a clump of diameter d covers pi (d/2)^2 of it.",
      "not_a_parameter": "There is no 'how much grass' number anywhere in the core. Both figures fall out of a rule and a measured diameter, and changing the diameter changes them.",
      "plants_per_m2": "cover_fraction / (pi (d/2)^2), which for the closure is 1 / d^2"
    },
    "tufts_per_m2": 1.0
  },
  "digest": "29a7447f7558d4a8",
  "excluded": {
    "forest_slope": {
      "area_m2": 7100224.0,
      "cells": 110941,
      "why": "the scarp and the north plateau, whole, by zone name. R0045: no large tree in open meadow, and the scarp is where the trees are. This is the one exclusion that is exclusive on its own."
    },
    "tracks": {
      "area_m2": 51584.0,
      "cells": 806,
      "why": "the cells a track polyline runs through, tested against half the cell's own diagonal so the test needs no width the map does not publish. THE TRACK WIDTH IS A KNOWN GAP: worldmap.json tracks carry id, serves and polyline and nothing else, so this carves the line and not the worn margin beside it."
    },
    "village_footprint": {
      "area_m2": 15360.0,
      "cells": 240,
      "why": "the one deliberate cluster's own footprint_radius_m. Graded ground, not meadow."
    },
    "water": {
      "area_m2": 641536.0,
      "cells": 10024,
      "why": "the river's and the lake's own wetted cells, at the plan's water distance of zero. The bank beyond the water IS stamped: it is meadow, and grass at a river's edge is what a river's edge looks like."
    }
  },
